# Leave unset to use local SQLite (backend/pocket_tutor.db).
#
# For Supabase: Project Settings → Database → Connection string.
# On Vercel, use the Transaction pooler URI (port 6543).
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Required for authenticated accounts and private image uploads.
# SUPABASE_URL=https://[PROJECT_REF].supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# SUPABASE_STORAGE_BUCKET=student-images
