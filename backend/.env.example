# Database. Leave DATABASE_URL unset to use local SQLite.
# For Supabase/Vercel, prefer the transaction pooler URI (port 6543).
# DATABASE_URL=postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=

# Optional local SQLite override. POCKET_TUTOR_DB_PATH remains supported for legacy/test setups.
BINDIT_DB_PATH=

# Supabase project settings used for authentication.
# The anon key is intentionally public; NEVER put the service-role key in frontend code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Backend-only settings for private image storage.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=student-images

# Backend-only AI tutor/grader settings. Never expose this key in frontend code.
OPENROUTER_API_KEY=
# Optional model override. Defaults to OpenRouter Auto Router for task-appropriate model selection.
OPENROUTER_MODEL=openrouter/auto
