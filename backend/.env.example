# Database (use your hosted Postgres/Supabase connection string in production)
DATABASE_URL=

# Supabase project settings used for authentication.
# The anon key is intentionally public; NEVER put the service-role key in frontend code.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
